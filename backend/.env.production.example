# QuickIndex API settings for production. Copy to backend/.env.production (git-ignored) and fill in.
# NEVER commit the real file, put it in an image, or paste its values into chat. Prefer a secrets manager where your host has one.
# Every setting the app reads is listed here (source of truth: backend/app/core/config.py).

# ---- Appwrite (the only data service) ----------------------------------------------------------
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
# Server API key with ONLY the databases/tables/rows scopes it needs (no users scopes).
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=quickindex
APPWRITE_URLS_TABLE_ID=urls
APPWRITE_CHECKS_TABLE_ID=checks
APPWRITE_CHECK_BATCHES_TABLE_ID=check_batches
APPWRITE_BATCH_SHARING_TABLE_ID=batch_sharing
APPWRITE_GOOGLE_CONNECTIONS_TABLE_ID=google_connections
APPWRITE_GSC_TARGETS_TABLE_ID=gsc_targets
APPWRITE_GSC_HISTORY_TABLE_ID=gsc_history
APPWRITE_GOOGLE_QUOTA_TABLE_ID=google_quota
APPWRITE_GOOGLE_OAUTH_STATES_TABLE_ID=google_oauth_states
# Rows per bulk request: 100 on the Free plan, up to 1000 on Pro.
APPWRITE_BULK_CHUNK_SIZE=100

# ---- Public URLs and CORS (must be HTTPS and same-site in production) -------------------------
FRONTEND_URL=https://app.example.com
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

# ---- IndexNow -----------------------------------------------------------------------------------
# 8-128 chars of letters, digits and dashes. Served at /<key>.txt.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_LOCATION=

# ---- Workers (they run INSIDE the single API process) -----------------------------------------
WORKER_COUNT=2
WORKER_BATCH_SIZE=5
MAX_ATTEMPTS=3
CHECK_WORKER_COUNT=2
CHECK_WORKER_BATCH_SIZE=10
CHECK_MAX_ATTEMPTS=2
CHECK_PER_HOST_CONCURRENCY=2
# Rows stuck in "processing" longer than this are returned to the queue.
STALE_LOCK_SECONDS=300
# Idle workers wake instantly when work is created in-process; this is only the safety-net poll (new setting).
WORKER_FALLBACK_POLL_SECONDS=240

# ---- Google Search Console (leave empty to keep the integration off) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/google/callback
# One or more Fernet keys, comma separated (first encrypts, all decrypt). Back this up: losing it forces every customer to reconnect.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Exactly one Google worker: the per-minute quota window is in memory.
GSC_WORKER_COUNT=1
GSC_INSPECT_PER_MINUTE=600
GSC_INSPECT_PER_DAY=2000
GSC_MAX_TARGETS_PER_USER=2000
GSC_MANUAL_RESERVE=200

# ---- Limits and abuse protection ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
MAX_QUEUED_PER_USER=5000
RECOVERY_PER_IP=5
RECOVERY_PER_EMAIL=3
VERIFICATION_RESEND_COOLDOWN=60
VERIFICATION_PER_HOUR=5

# ---- Retention (scheduled cleanup of old rows) and backups --------------------------------------
RETENTION_ENABLED=true
RETENTION_CHECK_BATCH_DAYS=90
RETENTION_SUBMISSION_DAYS=90
RETENTION_GSC_HISTORY_DAYS=365
RETENTION_OAUTH_STATE_HOURS=1
RETENTION_QUOTA_DAYS=7
# Encrypts backup archives written by scripts/backup_export.py. Store it separately from the backups.
BACKUP_ENCRYPTION_KEY=

# ---- Optional discovery channels ----------------------------------------------------------------
# Public sitemap/feed listing EVERY customer's URLs. Keep false: it exposes all customers' submissions together.
PUBLIC_GLOBAL_FEED=false
WAYBACK_SAVE=false
USE_PROXY=false
PING_ENDPOINTS=http://rpc.pingomatic.com/
PING_INTERVAL_SECONDS=900
WEBSUB_HUBS=https://pubsubhubbub.appspot.com/

# ---- Container runtime (read by the Dockerfile CMD, not by the app) --------------------------
# docker-compose.yml sets FORWARDED_ALLOW_IPS to the proxy's fixed IP. Never '*'.
# FORWARDED_ALLOW_IPS=172.28.0.10
