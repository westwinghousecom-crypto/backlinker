APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_URLS_TABLE_ID=urls
INDEXNOW_KEY=your_indexnow_key
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
WORKER_COUNT=2
WORKER_BATCH_SIZE=5
MAX_ATTEMPTS=3
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
USE_PROXY=false
PUBLIC_BASE_URL=http://localhost:8000

RATE_LIMIT_PER_MINUTE=10
STALE_LOCK_SECONDS=300

INDEXNOW_KEY_LOCATION=
WAYBACK_SAVE=false
PING_ENDPOINTS=http://rpc.pingomatic.com/
PING_INTERVAL_SECONDS=900

WEBSUB_HUBS=https://pubsubhubbub.appspot.com/

APPWRITE_CHECKS_TABLE_ID=checks
APPWRITE_CHECK_BATCHES_TABLE_ID=check_batches
CHECK_WORKER_COUNT=2
CHECK_WORKER_BATCH_SIZE=10
CHECK_MAX_ATTEMPTS=2
CHECK_PER_HOST_CONCURRENCY=2

MAX_QUEUED_PER_USER=5000
APPWRITE_BULK_CHUNK_SIZE=100
PUBLIC_GLOBAL_FEED=false

# --- Google Search Console (leave empty to keep the integration off; see GOOGLE_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GSC_WORKER_COUNT=1
GSC_INSPECT_PER_MINUTE=600
GSC_INSPECT_PER_DAY=2000
GSC_MAX_TARGETS_PER_USER=2000
APPWRITE_GOOGLE_CONNECTIONS_TABLE_ID=google_connections
APPWRITE_GSC_TARGETS_TABLE_ID=gsc_targets
APPWRITE_GSC_HISTORY_TABLE_ID=gsc_history
APPWRITE_GOOGLE_QUOTA_TABLE_ID=google_quota
APPWRITE_BATCH_SHARING_TABLE_ID=batch_sharing

# --- Account recovery / verification ---
FRONTEND_URL=http://localhost:3000
RECOVERY_PER_IP=5
RECOVERY_PER_EMAIL=3
VERIFICATION_RESEND_COOLDOWN=60
VERIFICATION_PER_HOUR=5
APPWRITE_GOOGLE_OAUTH_STATES_TABLE_ID=google_oauth_states
GSC_MANUAL_RESERVE=200
WORKER_FALLBACK_POLL_SECONDS=240

# Encrypts backup files (scripts/backup_export.py). Separate from TOKEN_ENCRYPTION_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
RETENTION_ENABLED=true
RETENTION_CHECK_BATCH_DAYS=90
RETENTION_SUBMISSION_DAYS=90
RETENTION_GSC_HISTORY_DAYS=365
RETENTION_OAUTH_STATE_HOURS=1
RETENTION_QUOTA_DAYS=7
