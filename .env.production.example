# Used by docker-compose.yml for interpolation (--env-file .env.production). PUBLIC values only: nothing in this file is secret.
# Copy to .env.production and edit. API secrets live in backend/.env.production (see backend/.env.production.example).

# Domains. They MUST share a registrable domain (same-site) and be served over HTTPS.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Web build arguments. Next.js inlines these into the browser bundle at BUILD time: changing one requires rebuilding the web image.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Scheme + host of your Appwrite endpoint (no path), for the web app's Content-Security-Policy connect-src.
# If your project uses a regional endpoint (for example https://fra.cloud.appwrite.io/v1), use that host here as well.
APPWRITE_ORIGIN=https://cloud.appwrite.io

# Fixed container addresses (change only if the default subnet clashes with your host network).
QI_SUBNET=172.28.0.0/24
PROXY_IP=172.28.0.10
API_IP=172.28.0.20
WEB_IP=172.28.0.30
